# Copy to .env and fill in real values.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=billboard-hub

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret
NEXTAUTH_URL=http://localhost:3000
# Required ONLY when self-hosting a production build (next start behind your own
# proxy, Docker, a VM). Vercel is trusted automatically. Without it, Auth.js
# rejects every /api/auth/* request with UntrustedHost and nobody can log in.
# Set it only where the proxy overwrites the Host header rather than passing a
# client-supplied one through.
# AUTH_TRUST_HOST=true
# Canonical public origin, used for OG/canonical tags, password-reset links, and
# Stripe return URLs. On Vercel, set this for the Production environment ONLY —
# preview deployments fall back to their own URL automatically. See
# docs/guides/deployment.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=604800000
SALT_ROUNDS=12
# How long a password-reset link stays usable. Defaults to 3600000 (one hour).
PASSWORD_RESET_TTL_MS=3600000

# --- Outbound email (password reset) ---
# Without RESEND_API_KEY the app still issues reset tokens and prints the link
# to the server log, so local recovery flows work end to end. Set both values to
# deliver real mail; MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Boardly <no-reply@yourdomain.com>

# --- ImageKit (billboard image uploads) ---
# From the ImageKit dashboard: Developer options > API keys.
# The private key MUST stay server-side; the public key and URL endpoint are
# exposed to the browser (NEXT_PUBLIC_*).
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- Stripe (checkout payments) ---
# From the Stripe dashboard: Developers > API keys (use TEST keys locally).
# The secret key stays server-side. The webhook secret comes from the endpoint
# you create for POST /api/v1/webhooks/stripe (or `stripe listen` in local dev).
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Currently unused: cards are entered on Stripe's hosted Checkout page, so the
# browser never talks to Stripe directly. Kept for a future in-page integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# --- SEO, verification, and analytics (optional) ---
# Search Console HTML-tag verification token, without the surrounding meta tag.
GOOGLE_SITE_VERIFICATION=
# Configure ONE tracking method. GTM takes precedence when both are present.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
