# Copy to .env and fill in real values.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=billboard-hub

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret
NEXTAUTH_URL=http://localhost:3000
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=604800000
SALT_ROUNDS=12

# --- ImageKit (billboard image uploads) ---
# From the ImageKit dashboard: Developer options > API keys.
# The private key MUST stay server-side; the public key and URL endpoint are
# exposed to the browser (NEXT_PUBLIC_*).
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
